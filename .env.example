# ==============================================================================
# VARIABLES DE ENTORNO — SUPABASE (MATEMÁTICA UNSE)
# ==============================================================================
# Obtén estas dos claves desde el panel de Supabase:
# Settings (ícono de engranaje) -> Data API / API Settings -> Project URL & Project API Keys (anon public)
#
# Copia este archivo a `.env.local` para desarrollo local y agrégalas también en:
# Vercel -> Settings -> Environment Variables
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key-aqui
